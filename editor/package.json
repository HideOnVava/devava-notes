{
  "name": "devava-notes-editor",
  "private": true,
  "description": "CodeMirror 6 for the WebView of Devava Notes. After changing main.js: npm install, npm run build, and commit the bundle.",
  "scripts": {
    "build": "esbuild main.js --bundle --minify --format=iife --target=safari16 --outfile=../src/main/resources/com/devavaxp/notes/editor.js && node copy-katex.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "katex": "^0.18.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
